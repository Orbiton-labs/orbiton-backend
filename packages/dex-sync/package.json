{
  "name": "@orbiton/dex-sync",
  "version": "1.3.0",
  "main": "dist/index.js",
  "files": [
    "build/",
    "@types"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start:dev": "tsx src/index.ts",
    "start:prod": "npm run build && node dist/index.js",
    "push:dev": "npx drizzle-kit push --config drizzle-dev.config.ts",
    "push:prod": "npx drizzle-kit push --config drizzle-prod.config.ts",
    "generate:dev": "npx drizzle-kit generate --config drizzle-dev.config.ts",
    "generate:prod": "npx drizzle-kit generate --config drizzle-prod.config.ts",
    "migrate:dev": "npx drizzle-kit migrate --config drizzle-dev.config.ts",
    "migrate:prod": "npx drizzle-kit migrate --config drizzle-prod.config.ts",
    "test": "npx jest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@oraichain/oraidex-common": "1.1.29",
    "@oraichain/oraidex-contracts-sdk": "1.0.55",
    "@oraichain/tonbridge-contracts-build": "^1.3.6",
    "@oraichain/tonbridge-contracts-sdk": "^1.3.6",
    "@orbiton/ton-lite-client": "^1.0.0",
    "@orbiton/ton-sdk": "^1.0.0",
    "@orbs-network/ton-access": "^2.3.3",
    "@ton-api/client": "^0.3.1",
    "@ton/core": "^0.56.3",
    "@ton/crypto": "^3.2.0",
    "@ton/sandbox": "^0.22.0",
    "@ton/ton": "^13.11.1",
    "@uniswap/v3-sdk": "^3.24.0",
    "async-mutex": "^0.5.0",
    "bignumber.js": "^9.1.2",
    "bn.js": "^5.2.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "cosmjs-types": "0.8.0",
    "drizzle-orm": "^0.39.2",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "http-status": "^2.0.0",
    "jest": "^29.7.0",
    "joi": "^17.13.3",
    "js-big-decimal": "^2.2.0",
    "jsbi": "^4.3.0",
    "mongoose": "^8.8.2",
    "morgan": "^1.10.0",
