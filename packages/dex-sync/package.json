{
  "name": "@orbiton/dex-sync",
  "version": "1.3.0",
  "main": "dist/index.js",
  "files": [
    "build/",
    "@types"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start:dev": "tsx src/index.ts",
    "start:prod": "npm run build && node dist/index.js",
    "push:dev": "npm run db:exec push --config=drizzle-dev.drizzle.config",
    "push:prod": "npm run db:exec push --config=drizzle-prod.drizzle.config",
    "db:exec": "drizzle-kit"
  },
  "dependencies": {
    "@oraichain/oraidex-common": "1.1.29",
    "@oraichain/oraidex-contracts-sdk": "1.0.55",
    "@oraichain/tonbridge-contracts-build": "^1.3.6",
    "@oraichain/tonbridge-contracts-sdk": "^1.3.6",
    "@orbiton/ton-lite-client": "^1.0.0",
    "@orbiton/ton-sdk": "^1.0.0",
    "@orbs-network/ton-access": "^2.3.3",
    "@ton/core": "^0.56.3",
    "@ton/crypto": "^3.2.0",
    "@ton/sandbox": "^0.22.0",
    "@ton/ton": "^13.11.1",
    "@uniswap/v3-sdk": "^3.24.0",
    "async-mutex": "^0.5.0",
    "bignumber.js": "^9.1.2",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "cosmjs-types": "0.8.0",
    "drizzle-orm": "^0.39.2",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "http-status": "^2.0.0",
    "joi": "^17.13.3",
    "jsbi": "^4.3.0",
    "mongoose": "^8.8.2",
    "morgan": "^1.10.0",
    "orbiton-contracts": "^0.0.10",
    "pg": "^8.13.1",
    "tonweb": "^0.0.66",
    "winston": "^3.14.2",
    "xss-clean": "^0.1.4"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/http-status": "^1.1.2",
    "drizzle-kit": "^0.30.4",
    "tsc-alias": "^1.8.10"
  }
